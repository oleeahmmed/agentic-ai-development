# এই ফাইলের নাম বদলে .env করুন, তারপর নিচের যেকোনো একটি ব্লক ব্যবহার করুন।
# .env কখনো git-এ commit করবেন না।

# --- ১) OpenAI ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- ২) OpenRouter (এক key-তে অনেক মডেল) ---
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini

# --- ৩) Google AI Studio (OpenAI-compatible endpoint) ---
# LLM_API_KEY=...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- ৪) Ollama (লোকাল মডেল, খরচ নেই) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# টিপ: মডেলের নাম আপনার provider-এর ড্যাশবোর্ড/ডকুমেন্টেশন থেকে মিলিয়ে নিন।
